# ============================================================
# NEON CRM — Fase 1 | Copie este arquivo para ".env" e preencha
# No EasyPanel: cole estas variáveis em Environment (sem o #)
# ============================================================

# --- Aplicação ---
APP_URL=https://crm.oliverglassservice.com
PORT=3000

# --- Banco de dados (docker-compose define a senha) ---
DB_PASSWORD=troque_por_uma_senha_forte

# --- OpenAI (sua conta: platform.openai.com) ---
# Crie uma chave NOVA e dedicada (nome sugerido: neon-crm-prod)
# e defina um limite de gasto mensal em Settings -> Limits.
OPENAI_API_KEY=
# Modelo barato para resumos/classificação/sugestões (80% do volume)
OPENAI_MODEL=gpt-4o-mini
# Modelo premium para redação comercial (campanhas, propostas)
OPENAI_MODEL_PREMIUM=gpt-4o
# Transcrição de áudios de WhatsApp (fala do cliente)
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Uazapi (painel: https://uazapi.dev/interno) ---
# Server URL da sua instância, ex: https://sua-instancia.uazapi.dev
UAZAPI_BASE_URL=
# Token da instância conectada ao WhatsApp Business
UAZAPI_TOKEN=
# Header de autenticação usado pela sua conta Uazapi
# (padrão "token"; se der 401, consulte docs.uazapi.com/docs/collections/authentication.md)
UAZAPI_AUTH_HEADER=token

# --- Segurança do webhook ---
# Qualquer string longa e aleatória. A Uazapi chamará:
# https://crm.oliverglassservice.com/webhooks/uazapi?secret=ESTE_VALOR
WEBHOOK_SECRET=troque_por_uma_string_aleatoria_longa
